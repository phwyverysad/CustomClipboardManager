<Application x:Class="CustomClipboardManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:CustomClipboardManager"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe Fluent Icons</FontFamily>
            <FontFamily x:Key="IBMPlexSansFont">pack://application:,,,/Fonts/#IBM Plex Sans, ./Fonts/#IBM Plex Sans, IBM Plex Sans, pack://application:,,,/Fonts/#IBM Plex Sans Thai, ./Fonts/#IBM Plex Sans Thai, IBM Plex Sans Thai, Segoe UI Variable Text, Segoe UI Variable Display, Leelawadee UI, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#IBM Plex Sans, ./Fonts/#IBM Plex Sans, IBM Plex Sans, pack://application:,,,/Fonts/#IBM Plex Sans Thai, ./Fonts/#IBM Plex Sans Thai, IBM Plex Sans Thai, Segoe UI Variable Text, Segoe UI Variable Display, Leelawadee UI, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="CodeFont">pack://application:,,,/Fonts/#IBM Plex Sans, ./Fonts/#IBM Plex Sans, IBM Plex Sans, pack://application:,,,/Fonts/#IBM Plex Sans Thai, ./Fonts/#IBM Plex Sans Thai, IBM Plex Sans Thai, pack://application:,,,/Fonts/#JetBrains Mono, ./Fonts/#JetBrains Mono, JetBrains Mono, Cascadia Code, Consolas, Courier New, monospace</FontFamily>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
