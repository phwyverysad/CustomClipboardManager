<Window x:Class="ClipboardWebSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClipboardWebSetup"
        mc:Ignorable="d"
        Title="Custom Clipboard Manager Setup" Height="440" Width="560"
        Icon="Clipboard.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="{StaticResource MainFont}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Hotkey Badge Button Style -->
        <Style x:Key="HotkeyBadgeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryButtonHoverBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Colors -->
        <SolidColorBrush x:Key="BgBrush" Color="#18181A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#222226"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#2A2A30"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#33333A"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9898A0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#409CFF"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#0066CC"/>
        <SolidColorBrush x:Key="SecondaryButtonBgBrush" Color="#2B2B30"/>
        <SolidColorBrush x:Key="SecondaryButtonHoverBgBrush" Color="#35353C"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#30D158"/>

        <!-- Custom CheckBox Style -->
        <Style x:Key="FluentCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryButtonHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger / Destructive Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AE81123"/>
            <Setter Property="Foreground" Value="#E81123"/>
            <Setter Property="BorderBrush" Value="#40E81123"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button (Min/Close) -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button (Red Hover) -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryButtonHoverBgBrush}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,22,4" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,4,4,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Card with Border (No shadow) -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Margin="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- Custom Titlebar -->
                <RowDefinition Height="*"/>  <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Clipboard.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                    <TextBlock x:Name="WindowTitleText" Text="Custom Clipboard Manager Setup" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" FontWeight="Medium"/>
                </StackPanel>

                <!-- Language Selector ComboBox -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ComboBox x:Name="LanguageComboBox" Width="135" Height="26"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                    </ComboBox>
                </StackPanel>

                <!-- Window Min & Close Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="—" Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="✕" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ================= PAGE 1: CONFIG / READY STATE ================= -->
            <Grid x:Name="ConfigPanel" Grid.Row="1" Margin="22,4,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- App Info Banner -->
                    <RowDefinition Height="Auto"/> <!-- Path Selection Card -->
                    <RowDefinition Height="*"/>    <!-- Options List Card -->
                    <RowDefinition Height="Auto"/> <!-- Action Buttons Footer -->
                </Grid.RowDefinitions>

                <!-- App Banner -->
                <Border Grid.Row="0" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Big Icon -->
                        <Image Grid.Column="0" Source="Clipboard.ico" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0"/>
                        <!-- Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="HeaderTitleText" Text="Custom Clipboard Manager" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="15" FontWeight="Bold"/>
                                <Border Background="#1AFFFFFF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppVersionText" Text="v1.0.0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="HeaderSubtitleText" Text="Clipboard History Manager"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Path Card -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock x:Name="DestinationFolderText" Text="Installation Folder:" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="2,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathTextBox" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,6" FontSize="12.5"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="BrowseButton" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Padding="12,6" FontSize="12" Click="BrowseButton_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Options Card -->
                <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="DesktopShortcutCheckBox" Content="Create Desktop Shortcut" Style="{StaticResource FluentCheckBox}" IsChecked="True"/>
                        <CheckBox x:Name="StartMenuCheckBox" Content="Create Start Menu Shortcut" Style="{StaticResource FluentCheckBox}" IsChecked="True"/>
                        <CheckBox x:Name="AutoStartCheckBox" Content="Start automatically with Windows" Style="{StaticResource FluentCheckBox}" IsChecked="True"/>
                        <CheckBox x:Name="InstallServiceCheckBox" Content="Enable Background Service" Style="{StaticResource FluentCheckBox}" IsChecked="False" Visibility="Collapsed"/>
                        <CheckBox x:Name="LaunchAppCheckBox" Content="Launch app after installation" Style="{StaticResource FluentCheckBox}" IsChecked="True"/>
                    </StackPanel>
                </Border>

                <!-- Footer Buttons -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="UninstallButton" Content="Uninstall" Style="{StaticResource DangerButtonStyle}"
                            Visibility="Collapsed" Click="UninstallButton_Click"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0" Click="CancelButton_Click"/>
                        <Button x:Name="InstallButton" Content="Install Now" Style="{StaticResource PrimaryButtonStyle}"
                                Click="InstallButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= PAGE 2: PROGRESS / INSTALLING STATE ================= -->
            <Grid x:Name="ProgressPanel" Grid.Row="1" Margin="26,20,26,20" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <!-- Progress Icon -->
                    <Image Source="Clipboard.ico" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <!-- Main Progress Step Text -->
                    <TextBlock x:Name="ProgressTitleText" Text="Installing Custom Clipboard Manager..." Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <!-- Secondary Detail / Status -->
                    <TextBlock x:Name="ProgressDetailText" Text="Please wait while files are being configured..." Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                    <!-- Progress Bar -->
                    <ProgressBar x:Name="InstallProgressBar" Height="8" Minimum="0" Maximum="100" Value="15"
                                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource AccentBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="10,0,10,8"/>

                    <!-- Download Speed & Percentage Indicator -->
                    <Grid Margin="12,0,12,0">
                        <TextBlock x:Name="ProgressSpeedText" Text="Preparing..." Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11.5" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ProgressPercentText" Text="0%" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ================= PAGE 3: COMPLETED STATE ================= -->
            <Grid x:Name="CompletePanel" Grid.Row="1" Margin="26,16,26,20" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <!-- Green Check Circle -->
                    <Border Width="56" Height="56" CornerRadius="28" Background="#2030D158" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Data="M 12,24 L 20,32 L 36,16" Stroke="{StaticResource SuccessBrush}" StrokeThickness="3.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="30" Height="30" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="CompleteTitleText" Text="Installation Complete!" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <TextBlock x:Name="CompleteMessageText" Text="Custom Clipboard Manager has been successfully installed."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                    <!-- Hotkey Customization Card -->
                    <Border x:Name="HotkeyCardBorder" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,10" Margin="10,0,10,18"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⌨️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HotkeyCardTitleText" Text="Hotkey Shortcut:" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="HotkeyStatusHintText" Grid.Column="1" Text="Click to record shortcut"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Interactive Hotkey Recorder Button -->
                                <Button x:Name="RecordHotkeyButton" Grid.Column="0" Height="32"
                                        Style="{StaticResource HotkeyBadgeButtonStyle}" Click="RecordHotkeyButton_Click">
                                    <TextBlock x:Name="CurrentHotkeyDisplayText" Text="Ctrl + Shift + V"
                                               FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Button>

                                <!-- Preset Dropdown -->
                                <ComboBox x:Name="PresetHotkeyComboBox" Grid.Column="1" Width="130" Height="32" Margin="6,0,0,0"
                                          Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="PresetHotkeyComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Ctrl + Shift + V" Tag="Ctrl+Shift+V" IsSelected="True"/>
                                    <ComboBoxItem Content="Alt + V" Tag="Alt+V"/>
                                    <ComboBoxItem Content="Ctrl + `" Tag="Ctrl+Oem3"/>
                                    <ComboBoxItem Content="Win + V" Tag="Win+V"/>
                                    <ComboBoxItem Content="Ctrl + Shift + Z" Tag="Ctrl+Shift+Z"/>
                                    <ComboBoxItem x:Name="PresetCustomItem" Content="Custom..." Tag="Custom"/>
                                </ComboBox>

                                <!-- Reset Button -->
                                <Button x:Name="ResetHotkeyButton" Grid.Column="2" Content="↺" Width="32" Height="32" Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="0" FontSize="14"
                                        Click="ResetHotkeyButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Launch & Finish Button -->
                    <Button x:Name="FinishButton" Content="Launch &amp; Finish" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Padding="28,9" Click="FinishButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ================= PAGE 4: ERROR STATE ================= -->
            <Grid x:Name="ErrorPanel" Grid.Row="1" Margin="26,20,26,20" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <!-- Red Error Icon -->
                    <Border Width="56" Height="56" CornerRadius="28" Background="#26FF453A" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="✕" Foreground="#FF453A" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="ErrorTitleText" Text="Installation Encountered an Error" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <TextBlock x:Name="ErrorMessageText" Text="Error details here..." Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="10,0,10,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ErrorCloseButton" Content="Close" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="CloseButton_Click"/>
                        <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource PrimaryButtonStyle}" Click="RetryButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
