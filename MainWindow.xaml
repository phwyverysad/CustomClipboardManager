        <!-- Selectable Read-Only Text Box (Looks like TextBlock, fully selectable with mouse & context menu) -->
        <Style x:Key="SelectableReadOnlyTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PreviewTextBox_PreviewMouseLeftButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Command="ApplicationCommands.Copy" Header="{Binding PlacementTarget.Tag.Strings.ButtonCopy, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="ApplicationCommands.SelectAll" Header="{Binding PlacementTarget.Tag.Strings.ButtonSelectAll, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="SelectAllOn24" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Margin="0" Opacity="0">
        <Grid>
            <!-- Scope adorners (focus visuals, etc.) to main content so they never bleed over modal overlays -->
            <AdornerDecorator>
                <Grid Margin="14,14,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Filters -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Traffic Lights (Close Button, when pinned) -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                Visibility="{Binding IsWindowPinned, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource TrafficLightCloseButtonStyle}" ToolTip="Close" Click="TrafficRed_Click"/>
                    </StackPanel>

                    <!-- Fluent Search Box -->
                    <ui:TextBox x:Name="SearchBox" Grid.Column="1"
                                PlaceholderText="{Binding Strings.SearchPlaceholder}"
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PreviewKeyDown="SearchBox_PreviewKeyDown"
                                PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                                AllowDrop="True"
                                PreviewDragOver="SearchBox_PreviewDragOver"
                                PreviewDrop="SearchBox_PreviewDrop"
                                ClearButtonEnabled="True"
                                FontSize="13.5"
                                Padding="10,6"
                                VerticalAlignment="Center">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" FontSize="15"/>
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Header Tools -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <!-- Trash / Selection Mode -->
                        <ui:Button Command="{Binding ToggleSelectionModeCommand}" Style="{StaticResource HeaderClearButtonStyle}" ToolTip="{Binding SelectionModeHeaderTooltip}">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding PlacementTarget.Tag.Strings.TooltipClearAll, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding RequestConfirmClearAllCommand}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Delete24" Foreground="#FF453A"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MenuSelect, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding ToggleSelectionModeCommand}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Checkmark24"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="#FF453A"/>
                        </ui:Button>
                        <!-- Pin Button -->
                        <ToggleButton x:Name="PinButton" Command="{Binding TogglePinWindowCommand}" IsChecked="{Binding IsWindowPinned, Mode=OneWay}" Style="{StaticResource HeaderPinButtonStyle}" ToolTip="{Binding Strings.TooltipPin}"/>
                        <!-- Theme Button -->
                        <ui:Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource HeaderThemeButtonStyle}" ToolTip="{Binding Strings.TooltipTheme}">
                            <ui:SymbolIcon Symbol="{Binding IsDarkMode, Converter={StaticResource ThemeIconConverter}}" FontSize="15" Foreground="{DynamicResource TextForegroundBrush}"/>
                        </ui:Button>
                        <!-- Hotkey Settings Button -->
                        <ui:Button x:Name="SettingsButton" Click="SettingsButton_Click" Style="{StaticResource HeaderThemeButtonStyle}" ToolTip="{Binding Strings.TooltipHotkeySettings}">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="15" Foreground="{DynamicResource TextForegroundBrush}"/>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Filters -->
                <ScrollViewer x:Name="FilterScrollViewer" Grid.Row="1" Margin="0,2,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="FilterScrollViewer_PreviewMouseWheel">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton IsChecked="True" Style="{StaticResource FilterToggleStyle}" Command="{Binding FilterTypeCommand}" CommandParameter="All">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Collections24" FontSize="12.5" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Strings.FilterAll}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterToggleStyle}" Command="{Binding FilterTypeCommand}" CommandParameter="Pinned">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Pin24" FontSize="12.5" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Strings.FilterPinned}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterToggleStyle}" Command="{Binding FilterTypeCommand}" CommandParameter="Text">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentText24" FontSize="12.5" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Strings.FilterText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterToggleStyle}" Command="{Binding FilterTypeCommand}" CommandParameter="Image">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Image24" FontSize="12.5" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Strings.FilterImage}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterToggleStyle}" Command="{Binding FilterTypeCommand}" CommandParameter="Link">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Link24" FontSize="12.5" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Strings.FilterLink}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterToggleStyle}" Command="{Binding FilterTypeCommand}" CommandParameter="Files">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="12.5" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Strings.FilterFiles}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterToggleStyle}" Command="{Binding FilterTypeCommand}" CommandParameter="ColorCode">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Color24" FontSize="12.5" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Strings.FilterColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterToggleStyle}" Command="{Binding FilterTypeCommand}" CommandParameter="Code">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Code24" FontSize="12.5" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Strings.FilterCode}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterToggleStyle}" Command="{Binding FilterTypeCommand}" CommandParameter="Others">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Strings.FilterOthers}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Selection Action Bar (Batch Delete Mode) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ElementBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Select All CheckBox -->
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelectAll, Mode=TwoWay}"
                              IsThreeState="False"
                              Focusable="False"
                              FocusVisualStyle="{x:Null}"
                              IsTabStop="False"
                              Style="{StaticResource FluentToolbarCheckBoxStyle}"
                              VerticalAlignment="Center"
                              ToolTip="{Binding Strings.SelectAll}">
                        <TextBlock Text="{Binding Strings.SelectAll}" 
                                   Foreground="{DynamicResource TextForegroundBrush}" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Margin="8,0,0,0" 
                                   VerticalAlignment="Center"/>
                    </CheckBox>

                    <!-- Selected Count Summary -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedCountSummary}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <!-- Delete Selected Button -->
                    <Button Grid.Column="2"
                            Command="{Binding DeleteSelectedCommand}"
                            IsEnabled="{Binding HasSelectedItems}"
                            Style="{StaticResource SelectionDeleteButtonStyle}"
                            ToolTip="{Binding Strings.DeleteSelected}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="White" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding DeleteButtonText}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Exit Selection Mode Button -->
                    <Button Grid.Column="3"
                            Command="{Binding ExitSelectionModeCommand}"
                            Style="{StaticResource SelectionCancelButtonStyle}"
                            ToolTip="{Binding Strings.Cancel}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Empty State with Calming Float Animation -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ClipboardItemsView.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="EmptyIconTranslate" Y="0"/>
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="EmptyIconTranslate" Storyboard.TargetProperty="Y"
                                                     From="0" To="-7" Duration="0:0:1.8" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="52" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Binding Strings.EmptyTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" Margin="0,14,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Strings.EmptySubtitle}" Foreground="{DynamicResource TextFaintBrush}" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Item List -->
            <ListView x:Name="ItemsListView" Grid.Row="2" ItemsSource="{Binding ClipboardItemsView}" 
                      Focusable="False"
                      IsTabStop="False"
                      Background="Transparent" BorderThickness="0" 
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.CacheLength="2,3"
                      VirtualizingPanel.CacheLengthUnit="Page"
                      VirtualizingPanel.IsContainerVirtualizable="True"
                      Padding="0,0,2,0"
                      PreviewMouseLeftButtonDown="ItemsListView_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="ItemsListView_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="ItemsListView_PreviewMouseLeftButtonUp"
                      ContextMenuOpening="ItemsListView_ContextMenuOpening"
                      AllowDrop="True"
                      PreviewDragOver="ItemsListView_PreviewDragOver"
                      PreviewDrop="ItemsListView_PreviewDrop">
                <ListView.Template>
                    <ControlTemplate TargetType="ListView">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="ItemsScrollViewer"
                                          Focusable="False" 
                                          CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                   Grid.Column="0"
                                                                   CanContentScroll="{TemplateBinding CanContentScroll}" 
                                                                   Margin="{TemplateBinding Padding}"/>
                                            
                                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                                       Grid.Column="1"
                                                       Orientation="Vertical"
                                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                       Minimum="0"
                                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                       Width="4"
                                                       Margin="4,2,0,2"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       Focusable="False"
                                                       Style="{StaticResource SleekScrollBarStyle}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListView.Template>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Margin" Value="0,0,0,7"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=DataContext}"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MenuPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.PreviewItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Space">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Eye24" FontSize="15"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MenuCopy, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.CopyOnlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="15"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MenuPin, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.PinItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Pin24" FontSize="15"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="UPPERCASE" Command="{Binding PlacementTarget.Tag.TransformUpperCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="TextCaseUppercase24" FontSize="15"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="lowercase" Command="{Binding PlacementTarget.Tag.TransformLowerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="TextCaseLowercase24" FontSize="15"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MenuOrganize, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.OrganizeComponentsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="TextAlignLeft24" FontSize="15"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Trim Extra Spaces" Command="{Binding PlacementTarget.Tag.TransformStripCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Spacebar24" FontSize="15"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MenuOriginalText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.TransformResetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="15"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MenuDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="#FF453A">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="#FF453A"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" Background="{DynamicResource CardBackgroundBrush}" 
                                            CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="12,10"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}"/>
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.IsSelectionMode}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardSelectedBackgroundBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource CardSelectedBorderBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardSelectedBackgroundBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource CardSelectedBorderBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                        <Trigger Property="local:MainWindow.IsItemPressed" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0.985" Duration="0:0:0.06">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0.985" Duration="0:0:0.06">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.1">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.1">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ElementPressedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Selection CheckBox (Placed cleanly in front of card text/content) -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Focusable="False"
                                      FocusVisualStyle="{x:Null}"
                                      IsTabStop="False"
                                      VerticalAlignment="Top"
                                      Margin="0,1,10,0">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource FluentCardCheckBoxStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ListView}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>

                            <!-- Card Content (Header & Body) -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                            
                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Left: Category, Pinned Indicator, Time & Metadata -->
                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                    <!-- Category Badge -->
                                    <Border x:Name="CategoryBadge" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding CategoryBadgeText}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Pinned Indicator (always visible if pinned) -->
                                    <Border Background="#26FFAA00" CornerRadius="4" Padding="4,2" Margin="0,0,6,0"
                                            BorderThickness="1" BorderBrush="#4DFFAA00"
                                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Pin24" FontSize="10" Foreground="#FFAA00" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding PinnedBadgeText}" Foreground="#FFAA00" FontSize="9" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Metadata & Time -->
                                    <TextBlock Text="{Binding MetadataText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding FullTimestamp}">
                                        <ui:SymbolIcon Symbol="Clock20" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,3.5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TimeDisplay}" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Action Buttons (Hover Reveal with Smooth Fade) -->
                                <StackPanel x:Name="ActionsHost" Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center"
                                            Opacity="0" IsHitTestVisible="False">

                                    <ui:Button Style="{StaticResource CardActionButtonStyle}"
                                               Command="{Binding DataContext.PreviewItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="{Binding DataContext.Strings.TooltipCardPreview, RelativeSource={RelativeSource AncestorType=ListView}}">
                                        <ui:SymbolIcon Symbol="Eye24" FontSize="14" Foreground="{DynamicResource TextForegroundBrush}"/>
                                    </ui:Button>

                                    <ui:Button Style="{StaticResource CardActionButtonStyle}"
                                               Command="{Binding DataContext.CopyOnlyCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="{Binding DataContext.Strings.TooltipCardCopy, RelativeSource={RelativeSource AncestorType=ListView}}">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="14" Foreground="{DynamicResource TextForegroundBrush}"/>
                                    </ui:Button>

                                    <ui:Button Style="{StaticResource CardActionButtonStyle}"
                                               Command="{Binding DataContext.PinItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="{Binding DataContext.Strings.TooltipCardPin, RelativeSource={RelativeSource AncestorType=ListView}}">
                                        <ui:SymbolIcon Symbol="Pin24" FontSize="14">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFAA00"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </ui:Button>

                                    <ui:Button Style="{StaticResource CardActionDeleteButtonStyle}"
                                               Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="{Binding DataContext.Strings.TooltipCardDelete, RelativeSource={RelativeSource AncestorType=ListView}}">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#FF453A"/>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <!-- Content Area -->
                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Foreground="{DynamicResource TextForegroundBrush}" FontSize="13" MaxHeight="60" TextTrimming="CharacterEllipsis" LineHeight="19">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ContentType}" Value="Text">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Category}" Value="Emoji">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ContentType}" Value="Audio">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ContentType}" Value="Other">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Dedicated Emoji Display (Prominent, High-Visibility, Clean) -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,1,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Category}" Value="Emoji">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="32"
                                               FontFamily="Segoe UI Emoji, Noto Color Emoji, Segoe UI Symbol, Segoe UI, sans-serif"
                                               Foreground="{DynamicResource TextForegroundBrush}"
                                               VerticalAlignment="Center"
                                               LineHeight="38"/>
                                </Border>

                                <Border CornerRadius="6" HorizontalAlignment="Left" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ContentType}" Value="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding ImageContent}" MaxHeight="120" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Dedicated Compact Modern File Card -->
                                <Border CornerRadius="6" Padding="6,5" Background="{DynamicResource ElementBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" HorizontalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ContentType}" Value="FileDropList">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Compact Native Shell Icon (20x20) -->
                                        <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Image Source="{Binding FileIcon}" Width="18" Height="18" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FileIcon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <ui:SymbolIcon Symbol="Document20" FontSize="14" Foreground="{DynamicResource TextMutedBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FileIcon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>

                                        <!-- File Information (Clean, Sleek & Compact) -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- File Name & Extension Badge -->
                                            <DockPanel Grid.Row="0" LastChildFill="True">
                                                <Border DockPanel.Dock="Right" CornerRadius="3" Padding="3,0.5" Margin="4,0,0,0"
                                                        Background="{DynamicResource CardBackgroundBrush}"
                                                        BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileExtension}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding FileName}" 
                                                           FontWeight="SemiBold" FontSize="11.5" 
                                                           Foreground="{DynamicResource TextForegroundBrush}" 
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding FilePath}"/>
                                            </DockPanel>

                                            <!-- Compact Shortened Path & File Size -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,1.5,0,0">
                                                <ui:SymbolIcon Symbol="Folder16" FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,2.5,0"/>
                                                <TextBlock Text="{Binding ShortenedPath}" FontSize="10" 
                                                           Foreground="{DynamicResource TextMutedBrush}" 
                                                           TextTrimming="CharacterEllipsis" MaxWidth="175"
                                                           ToolTip="{Binding FilePath}" VerticalAlignment="Center"/>
                                                <TextBlock Text=" • " FontSize="9" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FileSizeText}" FontSize="10" 
                                                           Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            </Grid>
                        </Grid>

                        <DataTemplate.Triggers>
                            <!-- Hide hover actions during Selection Mode -->
                            <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ListView}}" Value="True">
                                <Setter TargetName="ActionsHost" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- Dynamic Category Colors (Fluent Tinted Badges) -->
                            <DataTrigger Binding="{Binding Category}" Value="Emoji">
                                <Setter TargetName="CategoryBadge" Property="Background" Value="#26FFAA00"/>
                                <Setter TargetName="CategoryBadge" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="CategoryBadge" Property="BorderBrush" Value="#4DFFAA00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Text">
                                <Setter TargetName="CategoryBadge" Property="Background" Value="#1A808080"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Link">
                                <Setter TargetName="CategoryBadge" Property="Background" Value="#260078D7"/>
                                <Setter TargetName="CategoryBadge" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="CategoryBadge" Property="BorderBrush" Value="#4D0078D7"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="ColorCode">
                                <Setter TargetName="CategoryBadge" Property="Background" Value="#26107C10"/>
                                <Setter TargetName="CategoryBadge" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="CategoryBadge" Property="BorderBrush" Value="#4D107C10"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Image">
                                <Setter TargetName="CategoryBadge" Property="Background" Value="#26D24726"/>
                                <Setter TargetName="CategoryBadge" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="CategoryBadge" Property="BorderBrush" Value="#4DD24726"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Code">
                                <Setter TargetName="CategoryBadge" Property="Background" Value="#26EAA300"/>
                                <Setter TargetName="CategoryBadge" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="CategoryBadge" Property="BorderBrush" Value="#4DEAA300"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Files">
                                <Setter TargetName="CategoryBadge" Property="Background" Value="#268A2BE2"/>
                                <Setter TargetName="CategoryBadge" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="CategoryBadge" Property="BorderBrush" Value="#4D8A2BE2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Audio">
                                <Setter TargetName="CategoryBadge" Property="Background" Value="#2600B4D8"/>
                                <Setter TargetName="CategoryBadge" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="CategoryBadge" Property="BorderBrush" Value="#4D00B4D8"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Others">
                                <Setter TargetName="CategoryBadge" Property="Background" Value="{DynamicResource ElementBackgroundBrush}"/>
                            </DataTrigger>

                            <!-- Hover Reveal Actions -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsMouseOver}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActionsHost" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActionsHost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                                <Setter TargetName="ActionsHost" Property="IsHitTestVisible" Value="True"/>
                            </DataTrigger>

                            <!-- Selection Reveal Actions (Keyboard Navigation) -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                                <Setter TargetName="ActionsHost" Property="Opacity" Value="1"/>
                                <Setter TargetName="ActionsHost" Property="IsHitTestVisible" Value="True"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        </AdornerDecorator>

        <!-- Overlays -->
        <Grid x:Name="ToastGrid" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30">
            <Border Background="{DynamicResource ToastBackgroundBrush}" 
                    CornerRadius="20" Padding="16,8" 
                    BorderThickness="1" 
                    BorderBrush="{DynamicResource ToastBorderBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="#34C759" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource ToastForegroundBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="ConfirmGrid" Visibility="Collapsed" Background="{DynamicResource ModalBackdropBrush}" Opacity="0" CornerRadius="18" MouseDown="ConfirmBackdrop_MouseDown">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="300"
                  SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource DropShadowColor}" BlurRadius="24" ShadowDepth="6" Opacity="0.35" Direction="270"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="ConfirmBorder" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="24,20" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                        SnapsToDevicePixels="True" UseLayoutRounding="True"
                        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                        RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="36" Foreground="#FFAA00" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Strings.ConfirmClearTitle}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Strings.ConfirmClearMessage}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,0,0,20"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button x:Name="ConfirmCancelButton" Appearance="Secondary" Content="{Binding Strings.Cancel}" Click="ConfirmNo_Click" Width="105" Margin="0,0,10,0" Focusable="False" IsTabStop="False"/>
                            <ui:Button x:Name="ConfirmYesButton" Appearance="Danger" Content="{Binding Strings.ConfirmDeleteButton}" Click="ConfirmYes_Click" Width="105" Focusable="False" IsTabStop="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Hotkey Settings Modal Overlay (Crisp, Razor-Sharp Fluent Card) -->
        <Border x:Name="HotkeySettingsGrid" Visibility="Collapsed" Background="{DynamicResource ModalBackdropBrush}" Opacity="0" CornerRadius="18" MouseDown="HotkeySettingsBackdrop_MouseDown">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="396"
                  SnapsToDevicePixels="True" UseLayoutRounding="True">
                <!-- Drop shadow layer (pure background border, zero impact on ClearType / text sharpness) -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource DropShadowColor}" BlurRadius="24" ShadowDepth="6" Opacity="0.35" Direction="270"/>
                    </Border.Effect>
                </Border>

                <!-- Razor-Sharp Content Card -->
                <Border x:Name="HotkeySettingsBorder" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="20,16,10,16" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                        SnapsToDevicePixels="True" UseLayoutRounding="True"
                        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                        RenderOptions.ClearTypeHint="Enabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Scrollable Body -->
                            <RowDefinition Height="*"/>
                            <!-- Bottom Action Bar -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="19" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Strings.HotkeySettingsTitle}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Width="26" Height="26" Padding="0" Click="CloseHotkeySettings_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Focusable="False"/>
                        </Grid>

                        <!-- Scrollable Body -->
                        <ScrollViewer Grid.Row="1" MaxHeight="450" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,-4,0" Padding="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Strings.HotkeyHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,8"/>

                                <!-- Interactive Recorder Button (Glows when recording) -->
                                <Button x:Name="AppRecordHotkeyButton" Height="42" Margin="0,0,0,6" Click="AppRecordHotkeyButton_Click"
                                        Cursor="Hand" BorderThickness="1.5" BorderBrush="{DynamicResource CardBorderBrush}"
                                        Background="{DynamicResource SearchBackgroundBrush}" Focusable="False" IsTabStop="False">
                                    <TextBlock x:Name="AppHotkeyDisplayText" Text="Ctrl + Shift + V" FontWeight="Bold" FontSize="15"
                                               Foreground="{DynamicResource TextForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                 </Button>

                                <TextBlock x:Name="AppHotkeyHintText" Text="{Binding Strings.HotkeyInstructionHint}" 
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" TextAlignment="Center"/>

                                <!-- Modifier Checkboxes for Easy Click Configuration -->
                                <Border Background="{DynamicResource ElementBackgroundBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ModCtrlCheckBox" Grid.Column="0" Content="Ctrl" FontWeight="SemiBold" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed" Focusable="False" IsTabStop="False" HorizontalAlignment="Center"/>
                                        <CheckBox x:Name="ModAltCheckBox" Grid.Column="1" Content="Alt" FontWeight="SemiBold" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed" Focusable="False" IsTabStop="False" HorizontalAlignment="Center"/>
                                        <CheckBox x:Name="ModShiftCheckBox" Grid.Column="2" Content="Shift" FontWeight="SemiBold" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed" Focusable="False" IsTabStop="False" HorizontalAlignment="Center"/>
                                        <CheckBox x:Name="ModWinCheckBox" Grid.Column="3" Content="Win" FontWeight="SemiBold" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed" Focusable="False" IsTabStop="False" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Presets Selection (6 Popular Options) -->
                                <TextBlock Text="{Binding Strings.HotkeyPopularPresets}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <ui:Button Content="Ctrl + Shift + V" Margin="0,0,3,4" Padding="4,4.5" FontSize="10.5" Click="PresetButton_Click" Tag="CTRL+SHIFT+V" Focusable="False" IsTabStop="False"/>
                                    <ui:Button Content="Alt + V" Margin="2,0,2,4" Padding="4,4.5" FontSize="10.5" Click="PresetButton_Click" Tag="ALT+V" Focusable="False" IsTabStop="False"/>
                                    <ui:Button Content="Win + V" Margin="3,0,0,4" Padding="4,4.5" FontSize="10.5" Click="PresetButton_Click" Tag="WIN+V" Focusable="False" IsTabStop="False"/>
                                    <ui:Button Content="Ctrl + `" Margin="0,0,3,0" Padding="4,4.5" FontSize="10.5" Click="PresetButton_Click" Tag="CTRL+`" Focusable="False" IsTabStop="False"/>
                                    <ui:Button Content="Ctrl + Alt + V" Margin="2,0,2,0" Padding="4,4.5" FontSize="10.5" Click="PresetButton_Click" Tag="CTRL+ALT+V" Focusable="False" IsTabStop="False"/>
                                    <ui:Button Content="F8" Margin="3,0,0,0" Padding="4,4.5" FontSize="10.5" Click="PresetButton_Click" Tag="F8" Focusable="False" IsTabStop="False"/>
                                </UniformGrid>

                                <!-- System Integration, Privacy & Performance Section -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,0,10"/>

                                <!-- Windows Clipboard History (Win+V) Integration -->
                                <Border Background="{DynamicResource ElementBackgroundBrush}" CornerRadius="9" Padding="12,8" Margin="0,0,0,7" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Strings.SettingWindowsClipboardTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,0,1"/>
                                            <TextBlock Text="{Binding Strings.SettingWindowsClipboardHint}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" LineHeight="14"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                         IsChecked="{Binding IsWindowsClipboardHistoryEnabled, Mode=TwoWay}"
                                                         Focusable="False"/>
                                    </Grid>
                                </Border>

                                <!-- Prevent Screen Capture Protection -->
                                <Border Background="{DynamicResource ElementBackgroundBrush}" CornerRadius="9" Padding="12,8" Margin="0,0,0,7" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Strings.SettingScreenCaptureTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,0,1"/>
                                            <TextBlock Text="{Binding Strings.SettingScreenCaptureHint}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" LineHeight="14"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                         IsChecked="{Binding IsScreenCaptureProtectionEnabled, Mode=TwoWay}"
                                                         Focusable="False"/>
                                    </Grid>
                                </Border>

                                <!-- Efficiency & Power Saving Mode -->
                                <Border Background="{DynamicResource ElementBackgroundBrush}" CornerRadius="9" Padding="12,8" Margin="0,0,0,4" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Strings.SettingEfficiencyTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,0,1"/>
                                            <TextBlock Text="{Binding Strings.SettingEfficiencyHint}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" LineHeight="14"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                         IsChecked="{Binding IsEfficiencyModeEnabled, Mode=TwoWay}"
                                                         Focusable="False"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Action Bar -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <ui:Button Content="{Binding Strings.HotkeyResetDefault}" Appearance="Secondary" Margin="0,0,8,0" Click="ResetAppHotkey_Click" Padding="12,5.5" FontSize="12" Focusable="False" IsTabStop="False"/>
                            <ui:Button Content="{Binding Strings.HotkeyDone}" Appearance="Primary" Click="CloseHotkeySettings_Click" Padding="16,5.5" FontSize="12" Focusable="False" IsTabStop="False"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Fluent Quick Look & Detailed Inspection Modal -->
        <Border x:Name="PreviewGrid" Visibility="Collapsed" Background="{DynamicResource ModalBackdropBrush}" Opacity="0" CornerRadius="18" MouseDown="PreviewBackdrop_MouseDown">
            <Border x:Name="PreviewBorder"
                    Width="414" Height="565"
                    Margin="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Focusable="True"
                    FocusVisualStyle="{x:Null}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource DropShadowColor}" BlurRadius="36" ShadowDepth="10" Opacity="0.55" Direction="270"/>
                </Border.Effect>

                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <!-- Top Header: Badge, Title, Segmented Switcher & Close -->
                        <RowDefinition Height="Auto"/>
                        <!-- Main Body Content: Tab 0 (Preview) vs Tab 1 (Details) -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Action Bar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Header (Clean 2-Row Layout: Prevents Subtitle Clipping) -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,11,12,11">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0 Left: Badge + Title -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <!-- Category Badge -->
                                <Border Background="{Binding PreviewInfo.BadgeBackground}"
                                        BorderBrush="{Binding PreviewInfo.BadgeBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding PreviewInfo.BadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding PreviewInfo.Title}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Row 0 Right: Close Modal Button -->
                            <Button Grid.Row="0" Grid.Column="1" Command="{Binding ClosePreviewCommand}"
                                    Width="26" Height="26" BorderThickness="0" Background="Transparent"
                                    Cursor="Hand" ToolTip="{Binding DataContext.Strings.Close, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBd" Background="{TemplateBinding Background}" CornerRadius="13">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="{DynamicResource TextLabelBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBd" Property="Background" Value="{DynamicResource ElementHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Row 1: Subtitle on Left, Segmented View Switcher on Right -->
                            <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,7,0,0" LastChildFill="True">
                                <!-- Center/Right: Segmented View Switcher (Preview / Details) -->
                                <Border DockPanel.Dock="Right" Background="{DynamicResource ElementBackgroundBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="13" Padding="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding PreviewInfo.HasDetailsTab, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Preview Tab Button -->
                                        <Button Command="{Binding SelectPreviewTabCommand}" CommandParameter="0"
                                                Cursor="Hand" BorderThickness="0" Background="Transparent"
                                                ToolTip="{Binding DataContext.Strings.PreviewTab, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="PillBd" Background="Transparent" CornerRadius="11" Padding="8,3.5">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <ui:SymbolIcon x:Name="PillIco" Symbol="Eye24" FontSize="12" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                        <TextBlock x:Name="PillTxt" Text="{Binding DataContext.Strings.PreviewTab, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource ElementHoverBrush}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding PreviewInfo.SelectedTabIndex}" Value="0">
                                                                        <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter TargetName="PillTxt" Property="Foreground" Value="White"/>
                                                                        <Setter TargetName="PillIco" Property="Foreground" Value="White"/>
                                                                        <Setter TargetName="PillTxt" Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Details Tab Button -->
                                        <Button Command="{Binding SelectPreviewTabCommand}" CommandParameter="1"
                                                Cursor="Hand" BorderThickness="0" Background="Transparent"
                                                ToolTip="{Binding DataContext.Strings.DetailsTab, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="PillBd" Background="Transparent" CornerRadius="11" Padding="8,3.5">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <ui:SymbolIcon x:Name="PillIco" Symbol="DocumentBulletList24" FontSize="12" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                        <TextBlock x:Name="PillTxt" Text="{Binding DataContext.Strings.DetailsTab, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource ElementHoverBrush}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding PreviewInfo.SelectedTabIndex}" Value="1">
                                                                        <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter TargetName="PillTxt" Property="Foreground" Value="White"/>
                                                                        <Setter TargetName="PillIco" Property="Foreground" Value="White"/>
                                                                        <Setter TargetName="PillTxt" Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Subtitle on Left: Has plenty of room and never truncates! -->
                                <TextBlock Text="{Binding PreviewInfo.Subtitle}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextLabelBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Main Content Body Area -->
                    <Grid Grid.Row="1" Margin="12,10">
                        <!-- TAB 0: PREVIEW VIEW -->
                        <Grid Visibility="{Binding PreviewInfo.SelectedTabIndex, Converter={StaticResource TabToVisConverter}, ConverterParameter=0}">

                            <!-- IMAGE PREVIEW -->
                            <Grid Visibility="{Binding PreviewInfo.HasImagePreview, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Image Display Frame -->
                                <Border Grid.Row="0" Background="{DynamicResource ElementHoverBrush}" CornerRadius="10" Padding="6" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                    <Image Source="{Binding PreviewInfo.ImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Image Meta Info Capsule -->
                                <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,0" Background="{DynamicResource ElementHoverBrush}" CornerRadius="12" Padding="12,4">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Image24" FontSize="13" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding PreviewInfo.ImageResolutionText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text=" • " FontSize="11.5" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PreviewInfo.ImageAspectRatioText}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- FILE PREVIEW -->
                            <Grid Visibility="{Binding PreviewInfo.HasFilePreview, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <!-- Single File View -->
                                    <Grid Visibility="{Binding PreviewInfo.IsMultipleFiles, Converter={StaticResource InverseBoolToVis}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- File Header Card -->
                                        <Border Grid.Row="0" Background="{DynamicResource ElementBackgroundBrush}" CornerRadius="10" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" Source="{Binding PreviewInfo.LargeFileIcon}" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PreviewInfo.FileName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource ElementHoverBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding PreviewInfo.FileExtension}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding PreviewInfo.FileSizeText}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Embedded Preview: Image vs Text snippet vs Default File Icon -->
                                        <Grid Grid.Row="1">
                                            <!-- Embedded Image Preview for Image Files -->
                                            <Border Visibility="{Binding PreviewInfo.ImageSource, Converter={StaticResource NullToVis}}" Background="{DynamicResource ElementHoverBrush}" CornerRadius="10" Padding="6" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                                <Image Source="{Binding PreviewInfo.ImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>

                                            <!-- Embedded Text/Code Preview for Text Files -->
                                            <Border Visibility="{Binding PreviewInfo.HasFileTextContent, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ElementHoverBrush}" CornerRadius="10" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                                <TextBox Text="{Binding PreviewInfo.FileTextContent, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         IsReadOnlyCaretVisible="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         PreviewMouseLeftButtonDown="PreviewTextBox_PreviewMouseLeftButtonDown"
                                                         Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource TextForegroundBrush}"
                                                         FontFamily="pack://application:,,,/Fonts/#IBM Plex Sans, ./Fonts/#IBM Plex Sans, IBM Plex Sans, pack://application:,,,/Fonts/#IBM Plex Sans Thai, ./Fonts/#IBM Plex Sans Thai, IBM Plex Sans Thai, pack://application:,,,/Fonts/#JetBrains Mono, ./Fonts/#JetBrains Mono, JetBrains Mono, Cascadia Code, Consolas, Courier New, monospace"
                                                         FontSize="11"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         FocusVisualStyle="{x:Null}"
                                                         Cursor="IBeam"
                                                         IsInactiveSelectionHighlightEnabled="True"
                                                         SelectionBrush="{DynamicResource AccentBrush}"
                                                         Padding="0">
                                                    <TextBox.Template>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          Background="Transparent"/>
                                                        </ControlTemplate>
                                                    </TextBox.Template>
                                                    <TextBox.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Command="ApplicationCommands.Copy" Header="{Binding PlacementTarget.Tag.Strings.ButtonCopy, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon>
                                                                    <ui:SymbolIcon Symbol="Copy24" FontSize="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Command="ApplicationCommands.SelectAll" Header="{Binding PlacementTarget.Tag.Strings.ButtonSelectAll, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon>
                                                                    <ui:SymbolIcon Symbol="SelectAllOn24" FontSize="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </TextBox.ContextMenu>
                                                </TextBox>
                                            </Border>

                                            <!-- Standard Icon Card for other files (Binary, exe, etc.) -->
                                            <Border CornerRadius="10" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding PreviewInfo.ImageSource}" Value="{x:Null}"/>
                                                                    <Condition Binding="{Binding PreviewInfo.HasFileTextContent}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="{Binding PreviewInfo.LargeFileIcon}" Width="64" Height="64" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,10"/>
                                                    <TextBox Style="{StaticResource SelectableReadOnlyTextBoxStyle}"
                                                             Text="{Binding PreviewInfo.FileName, Mode=OneWay}"
                                                             FontSize="13.5" FontWeight="SemiBold"
                                                             Foreground="{DynamicResource TextForegroundBrush}"
                                                             HorizontalAlignment="Center"
                                                             HorizontalContentAlignment="Center"
                                                             TextAlignment="Center"
                                                             TextWrapping="Wrap"
                                                             MaxWidth="360"/>
                                                    <TextBox Style="{StaticResource SelectableReadOnlyTextBoxStyle}"
                                                             Text="{Binding PreviewInfo.FilePath, Mode=OneWay}"
                                                             FontSize="11"
                                                             Foreground="{DynamicResource TextLabelBrush}"
                                                             HorizontalAlignment="Center"
                                                             HorizontalContentAlignment="Center"
                                                             TextAlignment="Center"
                                                             TextWrapping="Wrap"
                                                             MaxWidth="360"
                                                             Margin="0,6,0,0"
                                                             ToolTip="{Binding PreviewInfo.FilePath}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- Multiple Files View -->
                                    <Grid Visibility="{Binding PreviewInfo.IsMultipleFiles, Converter={StaticResource BoolToVis}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding PreviewInfo.FileName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="2,0,0,6"/>
                                        <Border Grid.Row="1" Background="{DynamicResource ElementHoverBrush}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding PreviewInfo.MultipleFilesList}" Margin="0,0,8,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="8,6" CornerRadius="6" Margin="0,0,0,3" Background="{DynamicResource CardBackgroundBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- COLOR PREVIEW -->
                            <Grid Visibility="{Binding PreviewInfo.HasColorPreview, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="130"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Large Color Swatch with Drop Shadow -->
                                <Border Grid.Row="0" Background="{Binding PreviewInfo.ColorBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.25"/>
                                    </Border.Effect>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Background="#99000000" CornerRadius="6" Padding="7,3">
                                        <TextBlock Text="{Binding PreviewInfo.ColorHex}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Border>

                                <!-- Color Formats Cards -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,8,0">
                                        <!-- HEX -->
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="HEX" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PreviewInfo.ColorHex}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                                <ui:Button Grid.Column="2" Command="{Binding DataContext.CopyDetailValueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PreviewInfo.ColorHex}" Style="{StaticResource CardActionButtonStyle}" ToolTip="Copy HEX">
                                                    <ui:SymbolIcon Symbol="Copy24" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}"/>
                                                </ui:Button>
                                            </Grid>
                                        </Border>

                                        <!-- RGB -->
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="RGB" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PreviewInfo.ColorRgb}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                                <ui:Button Grid.Column="2" Command="{Binding DataContext.CopyDetailValueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PreviewInfo.ColorRgb}" Style="{StaticResource CardActionButtonStyle}" ToolTip="Copy RGB">
                                                    <ui:SymbolIcon Symbol="Copy24" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}"/>
                                                </ui:Button>
                                            </Grid>
                                        </Border>

                                        <!-- HSL -->
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="HSL" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PreviewInfo.ColorHsl}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                                <ui:Button Grid.Column="2" Command="{Binding DataContext.CopyDetailValueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PreviewInfo.ColorHsl}" Style="{StaticResource CardActionButtonStyle}" ToolTip="Copy HSL">
                                                    <ui:SymbolIcon Symbol="Copy24" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}"/>
                                                </ui:Button>
                                            </Grid>
                                        </Border>

                                        <!-- HSV -->
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="HSV" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PreviewInfo.ColorHsv}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                                <ui:Button Grid.Column="2" Command="{Binding DataContext.CopyDetailValueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PreviewInfo.ColorHsv}" Style="{StaticResource CardActionButtonStyle}" ToolTip="Copy HSV">
                                                    <ui:SymbolIcon Symbol="Copy24" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}"/>
                                                </ui:Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- TEXT & CODE PREVIEW -->
                            <Grid Visibility="{Binding PreviewInfo.HasTextPreview, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Component Formatter Toolbar (Shown when structured components detected) -->
                                <Border Grid.Row="0" Visibility="{Binding PreviewInfo.HasStructuredComponents, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource ElementBackgroundBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,8"
                                        BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                    <DockPanel LastChildFill="True">
                                        <!-- Mode Switcher Segmented Pills docked Right (Guaranteed Full Width, Never Clipped) -->
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="2" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Formatted Pill (Mode 0) -->
                                                <Button Command="{Binding DataContext.SetTextFormatModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0"
                                                        Cursor="Hand" BorderThickness="0" Background="Transparent" ToolTip="{Binding DataContext.Strings.ModeFormatted, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="BtnBd" Background="Transparent" CornerRadius="6" Padding="8,3">
                                                                            <TextBlock x:Name="BtnTxt" Text="{Binding DataContext.Strings.ModeFormatted, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextLabelBrush}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource ElementHoverBrush}"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding PreviewInfo.TextFormatMode}" Value="0">
                                                                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                                <Setter TargetName="BtnTxt" Property="Foreground" Value="White"/>
                                                                                <Setter TargetName="BtnTxt" Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Raw Pill (Mode 1) -->
                                                <Button Command="{Binding DataContext.SetTextFormatModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="1"
                                                        Cursor="Hand" BorderThickness="0" Background="Transparent" Margin="2,0,0,0" ToolTip="{Binding DataContext.Strings.ModeRaw, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="BtnBd" Background="Transparent" CornerRadius="6" Padding="8,3">
                                                                            <TextBlock x:Name="BtnTxt" Text="{Binding DataContext.Strings.ModeRaw, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextLabelBrush}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource ElementHoverBrush}"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding PreviewInfo.TextFormatMode}" Value="1">
                                                                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                                <Setter TargetName="BtnTxt" Property="Foreground" Value="White"/>
                                                                                <Setter TargetName="BtnTxt" Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Clean Pill (Mode 2) -->
                                                <Button Command="{Binding DataContext.SetTextFormatModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="2"
                                                        Visibility="{Binding PreviewInfo.HasCleanText, Converter={StaticResource BoolToVis}}"
                                                        Cursor="Hand" BorderThickness="0" Background="Transparent" Margin="2,0,0,0" ToolTip="{Binding DataContext.Strings.ModeClean, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="BtnBd" Background="Transparent" CornerRadius="6" Padding="8,3">
                                                                            <TextBlock x:Name="BtnTxt" Text="{Binding DataContext.Strings.ModeClean, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextLabelBrush}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource ElementHoverBrush}"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding PreviewInfo.TextFormatMode}" Value="2">
                                                                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                                <Setter TargetName="BtnTxt" Property="Foreground" Value="White"/>
                                                                                <Setter TargetName="BtnTxt" Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Summary Label (No Icon, Fills remaining space, with Ellipsis if needed) -->
                                        <TextBlock Text="{Binding PreviewInfo.ComponentSummaryText}"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextLabelBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding PreviewInfo.ComponentSummaryText}"/>
                                    </DockPanel>
                                </Border>

                                <!-- Text Body with Downward Wrapping & Highlighting Support -->
                                <Border Grid.Row="1" Background="{DynamicResource ElementHoverBrush}" CornerRadius="10" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                    <TextBox x:Name="PreviewTextBox"
                                             Text="{Binding PreviewInfo.ActiveTextContent, Mode=OneWay}"
                                             IsReadOnly="True"
                                             IsReadOnlyCaretVisible="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             PreviewMouseLeftButtonDown="PreviewTextBox_PreviewMouseLeftButtonDown"
                                             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextForegroundBrush}"
                                             FontFamily="pack://application:,,,/Fonts/#IBM Plex Sans, ./Fonts/#IBM Plex Sans, IBM Plex Sans, pack://application:,,,/Fonts/#IBM Plex Sans Thai, ./Fonts/#IBM Plex Sans Thai, IBM Plex Sans Thai, pack://application:,,,/Fonts/#JetBrains Mono, ./Fonts/#JetBrains Mono, JetBrains Mono, Cascadia Code, Consolas, Segoe UI Variable Text, Leelawadee UI, Segoe UI, sans-serif"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             FocusVisualStyle="{x:Null}"
                                             Cursor="IBeam"
                                             IsInactiveSelectionHighlightEnabled="True"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             Padding="0">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Focusable="False"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto"
                                                              Background="Transparent"/>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Command="ApplicationCommands.Copy" Header="{Binding PlacementTarget.Tag.Strings.ButtonCopy, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Command="ApplicationCommands.SelectAll" Header="{Binding PlacementTarget.Tag.Strings.ButtonSelectAll, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="SelectAllOn24" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                </Border>
                            </Grid>

                            <!-- LINK PREVIEW -->
                            <Grid Visibility="{Binding PreviewInfo.HasLinkPreview, Converter={StaticResource BoolToVis}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                    <Border Width="56" Height="56" Background="{DynamicResource AccentColorBrush}" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <ui:SymbolIcon Symbol="Globe24" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding PreviewInfo.LinkDomain}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource ElementHoverBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" MaxWidth="320">
                                        <TextBox Style="{StaticResource SelectableReadOnlyTextBoxStyle}"
                                                 Text="{Binding PreviewInfo.LinkUrl, Mode=OneWay}"
                                                 FontSize="12" FontWeight="Medium"
                                                 Foreground="{DynamicResource TextLabelBrush}"
                                                 TextWrapping="Wrap"
                                                 HorizontalContentAlignment="Center"
                                                 TextAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- TAB 1: DETAILS METADATA VIEW (Crisp Cards, High Contrast Labels & Values) -->
                        <Grid Visibility="{Binding PreviewInfo.SelectedTabIndex, Converter={StaticResource TabToVisConverter}, ConverterParameter=1}">
                            <Border Background="{DynamicResource ElementBackgroundBrush}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Padding="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PreviewInfo.DetailsList}" Margin="0,0,10,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,8" CornerRadius="8" Margin="0,0,0,4" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Key / Label (Bold, High-Contrast) -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                        <!-- Value (Crisp Foreground, Full Text Wrapping, Selectable) -->
                                                        <TextBox Grid.Column="1"
                                                                 Style="{StaticResource SelectableReadOnlyTextBoxStyle}"
                                                                 Text="{Binding Value, Mode=OneWay}"
                                                                 FontSize="12" FontWeight="Medium"
                                                                 Foreground="{DynamicResource TextForegroundBrush}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center"
                                                                 Margin="6,0,6,0"
                                                                 ToolTip="{Binding Value}"/>

                                                        <!-- Copy Value Button -->
                                                        <ui:Button Grid.Column="2" Command="{Binding DataContext.CopyDetailValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   Visibility="{Binding IsCopyable, Converter={StaticResource BoolToVis}}"
                                                                   CommandParameter="{Binding}" Style="{StaticResource CardActionButtonStyle}"
                                                                   ToolTip="Copy property value" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Copy24" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}"/>
                                                        </ui:Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 3. Bottom Action Bar -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,10,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Context-specific action button on left -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Open File Button -->
                                <ui:Button Appearance="Secondary" Command="{Binding OpenPreviewTargetCommand}"
                                           Visibility="{Binding PreviewInfo.CanOpenFile, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,4,0" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="12.5" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DataContext.Strings.OpenFile, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- Open in Explorer Button -->
                                <ui:Button Appearance="Secondary" Command="{Binding RevealPreviewFolderCommand}"
                                           Visibility="{Binding PreviewInfo.CanOpenFolder, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,4,0" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12.5" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DataContext.Strings.OpenFolder, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- Open Link Button -->
                                <ui:Button Appearance="Secondary" Command="{Binding OpenPreviewTargetCommand}"
                                           Visibility="{Binding PreviewInfo.CanOpenLink, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,4,0" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="12.5" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DataContext.Strings.OpenFile, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- Save Image Button -->
                                <ui:Button Appearance="Secondary" Command="{Binding SavePreviewImageCommand}"
                                           Visibility="{Binding PreviewInfo.CanSaveImage, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,4,0" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" FontSize="12.5" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DataContext.Strings.SaveImage, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <!-- Standard actions on right: Select All, Copy & Paste -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Dedicated Select All Button for Text Preview -->
                                <ui:Button Appearance="Secondary" Click="PreviewSelectAll_Click"
                                           Visibility="{Binding PreviewInfo.HasTextPreview, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,5,0" Padding="10,5" ToolTip="{Binding DataContext.Strings.ButtonSelectAll, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="SelectAllOn24" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DataContext.Strings.ButtonSelectAll, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="Secondary" Command="{Binding CopyPreviewContentCommand}"
                                           Margin="0,0,5,0" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DataContext.Strings.ButtonCopy, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="Primary" Command="{Binding PasteItemCommand}" CommandParameter="{Binding PreviewInfo.SourceItem}"
                                           Padding="12,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="White" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DataContext.Strings.ButtonPaste, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
        </Grid>
    </Border>
</Window>
