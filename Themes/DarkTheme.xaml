<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Solid Crisp Dark Slate App Background (No murky transparency) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3E4246"/>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="TextForegroundBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="TextLabelBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="AccentColorBrush" Color="#0078D7"/>
    
    <!-- Clean Solid Elements -->
    <SolidColorBrush x:Key="ElementBackgroundBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ElementHoverBrush" Color="#353535"/>
    <SolidColorBrush x:Key="ElementPressedBrush" Color="#404040"/>
    
    <Color x:Key="DropShadowColor">#00000000</Color>

    <!-- Theme Control Brushes -->
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#252525"/>
    <SolidColorBrush x:Key="SearchForegroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SearchBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="SearchCaretBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SearchFocusedBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SearchFocusedBorderBrush" Color="#0078D7"/>

    <SolidColorBrush x:Key="FilterForegroundBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="FilterBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="FilterHoverBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="FilterHoverForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FilterCheckedBackgroundBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="FilterCheckedBorderBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="FilterCheckedForegroundBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ListViewItemBorderBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ListViewItemHoverBackgroundBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ListViewItemHoverBorderBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="ListViewItemSelectedBackgroundBrush" Color="#243042"/>
    <SolidColorBrush x:Key="ListViewItemSelectedBorderBrush" Color="#0078D7"/>

    <!-- Fluent Card Brushes -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#252525"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#303030"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#4D4D4D"/>
    <SolidColorBrush x:Key="CardSelectedBackgroundBrush" Color="#1E2B3E"/>
    <SolidColorBrush x:Key="CardSelectedBorderBrush" Color="#800078D7"/>
    
    <!-- CheckBox Brushes -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#505A69"/>
    <SolidColorBrush x:Key="CheckBoxHoverBackgroundBrush" Color="#200078D7"/>
    
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#555555"/>

    <!-- Context Menu Brushes -->
    <SolidColorBrush x:Key="ContextMenuBackgroundBrush" Color="#222222"/>
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#383838"/>

    <!-- Toast & Notification Brushes (Deep Dark Slate) -->
    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#252525"/>
    <SolidColorBrush x:Key="ToastBorderBrush" Color="#3E4246"/>
    <SolidColorBrush x:Key="ToastForegroundBrush" Color="#F9FAFB"/>
    <Color x:Key="ToastShadowColor">#80000000</Color>
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#B2000000"/>

    <!-- Context Menu Submenu Fixes (Overrides SystemColors) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#222222"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#222222"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#222222"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#263345"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
</ResourceDictionary>
