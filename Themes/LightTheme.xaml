<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Solid Crisp Pure White App Background (No desktop wallpaper bleed-through) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#D9DCE0"/>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="TextForegroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="TextLabelBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#3E444D"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="AccentColorBrush" Color="#0078D7"/>
    
    <!-- Clean Neutral Elements (No murky dirty black translucency) -->
    <SolidColorBrush x:Key="ElementBackgroundBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="ElementHoverBrush" Color="#E4E7EB"/>
    <SolidColorBrush x:Key="ElementPressedBrush" Color="#D8DCE0"/>
    
    <Color x:Key="DropShadowColor">#00000000</Color>

    <!-- Theme Control Brushes -->
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="SearchForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SearchBorderBrush" Color="#E0E3E7"/>
    <SolidColorBrush x:Key="SearchCaretBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SearchFocusedBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SearchFocusedBorderBrush" Color="#0078D7"/>

    <SolidColorBrush x:Key="FilterForegroundBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="FilterBorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="FilterHoverBackgroundBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="FilterHoverForegroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="FilterCheckedBackgroundBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="FilterCheckedBorderBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="FilterCheckedForegroundBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ListViewItemBorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="ListViewItemHoverBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ListViewItemHoverBorderBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="ListViewItemSelectedBackgroundBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="ListViewItemSelectedBorderBrush" Color="#0078D7"/>

    <!-- Fluent Card Brushes -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#B0D5F7"/>
    <SolidColorBrush x:Key="CardSelectedBackgroundBrush" Color="#F0F6FE"/>
    <SolidColorBrush x:Key="CardSelectedBorderBrush" Color="#660078D7"/>
    
    <!-- CheckBox Brushes -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#B8BEC6"/>
    <SolidColorBrush x:Key="CheckBoxHoverBackgroundBrush" Color="#120078D7"/>
    
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C5CAD0"/>

    <!-- Context Menu Brushes -->
    <SolidColorBrush x:Key="ContextMenuBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#E2E5E8"/>

    <!-- Toast & Notification Brushes (Clean Light Theme) -->
    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToastBorderBrush" Color="#D9DCE0"/>
    <SolidColorBrush x:Key="ToastForegroundBrush" Color="#111827"/>
    <Color x:Key="ToastShadowColor">#26000000</Color>
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#66000000"/>

    <!-- Context Menu Submenu Fixes (Overrides SystemColors) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A1A1A"/>
</ResourceDictionary>
